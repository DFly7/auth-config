# Generate with: openssl rand -hex 32
AUTHENTIK_SECRET_KEY=

# POSTGRES_PASSWORD is used by the Postgres container (authentik-db). Authentik reads
# AUTHENTIK_POSTGRESQL__PASSWORD; set it to the same value, or leave unset so compose
# defaults AUTHENTIK_POSTGRESQL__PASSWORD from POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
AUTHENTIK_POSTGRESQL__PASSWORD=

# Admin user password — set on first user creation only; changing it later has no effect unless the user is deleted first
AUTHENTIK_ADMIN_PASSWORD=

# From Cloudflare Zero Trust dashboard (Tunnel B)
CLOUDFLARE_TUNNEL_TOKEN=
